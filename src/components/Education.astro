---
import { siteConfig } from "../config";
---

<section id="education" class="section-shell border-b border-white/20">
  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <p class="text-base font-semibold text-white">
        education
      </p>
      {
        siteConfig.education.map((edu) => (
          <div class="card mt-4 p-4">
            <h3 class="text-sm font-semibold text-white">{edu.degree}</h3>
            <p class="mt-1 text-xs text-white/60">{edu.school}</p>
            <p class="mt-1 text-xs text-white/45">{edu.dateRange}</p>
            {edu.achievements.length > 0 && (
              <p class="mt-3 text-xs leading-6 text-white/55">{edu.achievements[0]}</p>
            )}
          </div>
        ))
      }
    </div>

    <div>
      <p class="text-base font-semibold text-white">
        certifications
      </p>
      <div class="mt-4 grid gap-2">
        {
          siteConfig.certifications.map((cert) => (
            <div class="card px-4 py-3 text-xs text-white/60">
              {cert}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
