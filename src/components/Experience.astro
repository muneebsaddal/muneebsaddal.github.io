---
import { siteConfig } from "../config";
---

<section id="experience" class="section-shell border-b border-white/20">
  <div class="mb-4">
    <h2 class="text-base font-semibold text-white">experience</h2>
  </div>

  <div class="grid gap-3">
    {
      siteConfig.experience.map((exp) => (
        <article class="card grid gap-4 p-5 md:grid-cols-[220px_1fr]">
          <div>
            <p class="text-xs font-semibold text-white">{exp.dateRange}</p>
            <p class="mt-1 text-xs text-white/50">{exp.company}</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-white">{exp.title}</h3>
            <p class="mt-1 text-xs text-white/60">{exp.focus}</p>
            <ul class="mt-4 space-y-2">
              {exp.bullets.slice(0, 2).map((bullet) => (
                <li class="flex gap-2 text-xs leading-6 text-white/55">
                  <span class="text-white/45">-</span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
