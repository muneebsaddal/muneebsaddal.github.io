---
import { siteConfig } from "../config";
---

<footer id="contact" class="section-shell">
  <div class="card p-5">
    <p class="text-base font-semibold text-white">contact</p>
    <h2 class="mt-3 text-lg font-semibold text-white md:text-xl">
      Open to computer vision and AI automation work.
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-white/60">
      I work on computer vision systems, AI automation backends, LangGraph workflows, analytics dashboards, and production-ready AI prototypes.
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      <a href={`mailto:${siteConfig.social.email}`} class="border border-white px-3 py-2 text-xs font-semibold text-white hover:bg-white hover:text-black">
        email
      </a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="border border-white/25 px-3 py-2 text-xs font-semibold text-white/70 hover:border-white hover:text-white">
        linkedin
      </a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="border border-white/25 px-3 py-2 text-xs font-semibold text-white/70 hover:border-white hover:text-white">
        github
      </a>
    </div>
  </div>

  <div class="mt-6 flex flex-col justify-between gap-2 text-xs text-white/45 md:flex-row">
    <span>© {new Date().getFullYear()} {siteConfig.name}</span>
    <span>{siteConfig.role}</span>
  </div>
</footer>
