---
import { siteConfig } from "../config";
---

<section id="hero" class="border-b border-white/20">
  <div class="section-shell">
    <div class="grid gap-4 md:grid-cols-[1.25fr_0.75fr]">
      <div class="card p-5 md:p-6">
        <p class="text-xs text-white/50">
          {siteConfig.role} / {siteConfig.location}
        </p>
        <h1 class="mt-4 max-w-3xl text-2xl font-semibold leading-tight text-white md:text-3xl">
          {siteConfig.name}
        </h1>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-white/70">
          I build computer vision systems and AI automation workflows with production-minded architecture.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href="#work"
            class="border border-white px-3 py-2 text-xs font-semibold text-white hover:bg-white hover:text-black"
          >
            work
          </a>
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-white/25 px-3 py-2 text-xs font-semibold text-white/70 hover:border-white hover:text-white"
          >
            github
          </a>
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="border border-white/25 px-3 py-2 text-xs font-semibold text-white/70 hover:border-white hover:text-white"
          >
            email
          </a>
        </div>
      </div>

      <aside class="card p-5 md:p-6">
        <p class="text-xs font-semibold text-white/50">
          current stack
        </p>
        <div class="mt-5 grid gap-3">
          {
            siteConfig.stats.map((stat) => (
              <div class="border border-white/15 p-3">
                <strong class="block text-sm font-semibold text-white">{stat.value}</strong>
                <span class="mt-1 block text-xs leading-5 text-white/60">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </div>
</section>
