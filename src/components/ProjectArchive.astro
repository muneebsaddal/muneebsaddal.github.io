---
import { siteConfig } from "../config";
---

<section class="section-shell border-b border-white/20">
  <div class="mb-4">
    <h2 class="text-base font-semibold text-white">more projects</h2>
  </div>

  <div class="grid gap-3 md:grid-cols-2">
    {
      siteConfig.projectArchive.map((project) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="card group p-4 hover:border-white"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs text-white/45">{project.category}</p>
              <h3 class="mt-1 text-sm font-semibold text-white">
                {project.name}
              </h3>
            </div>
            <span class="text-xs text-white/45 transition-colors group-hover:text-white">
              repo
            </span>
          </div>
          <p class="mt-3 text-xs leading-6 text-white/60">
            {project.description}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.skills.slice(0, 4).map((skill) => (
              <span class="text-xs text-white/45">{skill}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>
