---
import { siteConfig } from "../config";
---

<section id="work" class="section-shell border-b border-white/20">
  <div class="mb-4 flex items-end justify-between gap-4">
    <h2 class="text-base font-semibold text-white">selected work</h2>
    <p class="hidden text-xs text-white/45 md:block">source-linked projects</p>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    {
      siteConfig.featuredProjects.map((project) => (
        <article class="card flex min-h-[260px] flex-col p-5">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="chip">{project.category}</span>
            <span class="text-xs text-white/40">{project.proofLabel}</span>
          </div>
          <h3 class="text-base font-semibold leading-6 text-white">
            {project.name}
          </h3>
          <p class="mt-3 text-sm leading-6 text-white/65">
            {project.description}
          </p>
          <p class="mt-3 text-xs leading-6 text-white/55">
            {project.outcome}
          </p>

          <div class="mt-auto pt-5">
            <div class="flex flex-wrap gap-2">
              {project.skills.slice(0, 5).map((skill) => (
                <span class="chip">
                  {skill}
                </span>
              ))}
            </div>
            {
              project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-flex border border-white/25 px-3 py-2 text-xs font-semibold text-white/70 hover:border-white hover:text-white"
                >
                  repo
                </a>
              )
            }
          </div>
        </article>
      ))
    }
  </div>
</section>
